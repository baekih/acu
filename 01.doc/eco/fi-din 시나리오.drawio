        <mxCell id="ElSULRLonc01Kt5JdD5u-1" value="&lt;span style=&quot;background-color: initial;&quot;&gt;1. 부팅화면이 끝나면 바로 화면1로 넘어간다.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="ElSULRLonc01Kt5JdD5u-0" vertex="1">
