ttom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj182 0 obj<</Contents[184 0 R]/CropBox[0 0 813 573]/Group<</CS/DeviceRGB/S/Transparency>>/MediaBox[0 0 813 573]/Parent 173 0 R/Resources 183 0 R/Rotate 0/Type/Page>>endobj183 0 obj<</ExtGState<</GDIModeMask 185 0 R/GDIModeNormal 186 0 R>>/Font<</F8 187 0 R>>/ProcSet[/PDF/Text]/XObject<</IF0 201 0 R>>>>endobj184 0 obj<</Filter/FlateDecode/Length 296>>stream
