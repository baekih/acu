ttom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj141 0 obj<</Contents[144 0 R 145 0 R 146 0 R 147 0 R 148 0 R 149 0 R 150 0 R 151 0 R]/CropBox[0 0 731 570]/Group<</CS/DeviceRGB/S/Transparency>>/MediaBox[0 0 731 570]/Parent 132 0 R/Resources 142 0 R/Rotate 0/Type/Page>>endobj142 0 obj<</ExtGState<</GDIModeMask 158 0 R/GDIModeNormal 159 0 R>>/Font<</F8 143 0 R>>/ProcSet[/PDF/Text]/XObject<</IF0 164 0 R>>>>endobj143 0 obj<</BaseFont/Courier/Encoding/WinAnsiEncoding/FirstChar 32/LastChar 255/Subtype/Type1/Type/Font>>endobj144 0 obj<</Filter/FlateDecode/Length 571>>stream
